# ==============================================================================
# SIH26056 — Real-Time Airfare Price Index for India
# Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Backend / Database Configuration
# SQLite is used by default for zero-setup local execution and hackathon demos.
# For production deployment with PostgreSQL, update with connection URI:
DATABASE_URL=sqlite:///./airfare_index.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/airfare_index

ENVIRONMENT=development
API_TITLE="SIH26056 Airfare Price Index API"

# Data Collection Configuration
# Optional: Set this to your Ignav API key to enable live flight scraping.
# If not provided, the pipeline runs gracefully in synthetic/demo mode.
# IGNAV_API_KEY=your_ignav_api_key_here

# Frontend Dashboard Configuration
# Base URL pointing to the FastAPI backend service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
